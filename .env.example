# Copy to .env and fill in only the platforms you want to post to.
# Any platform left blank reports an honest "not configured" failure
# (the app never fabricates a successful post).

# --- Mastodon ---------------------------------------------------------------
# Settings -> Development -> New application; copy the access token.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky ----------------------------------------------------------------
# Use an APP PASSWORD (Settings -> App Passwords), not your account password.
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# --- Telegram ---------------------------------------------------------------
# Create a bot via @BotFather for the token. CHAT_ID is @yourchannel (public)
# or a numeric id. Add the bot to the channel/group as an admin first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ----------------------------------------------------------------
# Channel -> Edit -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# --- DEV.to -----------------------------------------------------------------
# Settings -> Extensions -> DEV Community API Keys -> Generate.
DEVTO_API_KEY=

# --- Networking (optional) --------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
